<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context="com.yoshione.fingen.lock.PinActivity">

    <TextView
        android:id="@+id/pin_code_step_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/pin_code_dots_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/pin_code_error_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@android:color/holo_red_light"
        android:visibility="invisible" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:columnCount="3">

        <Button android:layout_width="80dp" android:layout_height="80dp" android:onClick="onKeyClick" android:tag="1" android:text="1" />
        <Button android:layout_width="80dp" android:layout_height="80dp" android:onClick="onKeyClick" android:tag="2" android:text="2" />
        <Button android:layout_width="80dp" android:layout_height="80dp" android:onClick="onKeyClick" android:tag="3" android:text="3" />
        <Button android:layout_width="80dp" android:layout_height="80dp" android:onClick="onKeyClick" android:tag="4" android:text="4" />
        <Button android:layout_width="80dp" android:layout_height="80dp" android:onClick="onKeyClick" android:tag="5" android:text="5" />
        <Button android:layout_width="80dp" android:layout_height="80dp" android:onClick="onKeyClick" android:tag="6" android:text="6" />
        <Button android:layout_width="80dp" android:layout_height="80dp" android:onClick="onKeyClick" android:tag="7" android:text="7" />
        <Button android:layout_width="80dp" android:layout_height="80dp" android:onClick="onKeyClick" android:tag="8" android:text="8" />
        <Button android:layout_width="80dp" android:layout_height="80dp" android:onClick="onKeyClick" android:tag="9" android:text="9" />
        <Space android:layout_width="80dp" android:layout_height="80dp" />
        <Button android:layout_width="80dp" android:layout_height="80dp" android:onClick="onKeyClick" android:tag="0" android:text="0" />
        <Button android:layout_width="80dp" android:layout_height="80dp" android:onClick="onKeyClick" android:tag="del" android:text="⌫" />
    </GridLayout>

</LinearLayout>
