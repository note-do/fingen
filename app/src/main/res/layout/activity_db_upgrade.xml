<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context="com.yoshione.fingen.ActivityDbUpgrade">

    <TextView
        android:id="@+id/dbUpgradeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/db_upgrade_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/dbUpgradeProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:max="100" />

    <TextView
        android:id="@+id/dbUpgradeStage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/dbUpgradeMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/db_upgrade_hint" />

    <Button
        android:id="@+id/dbUpgradeFreeSpace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/db_upgrade_free_space"
        android:visibility="gone" />

    <Button
        android:id="@+id/dbUpgradeRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/db_upgrade_retry"
        android:visibility="gone" />

</LinearLayout>
