<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="16dp"
    android:background="?listItemBackground"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <com.yoshione.fingen.widgets.FlipView
        android:id="@+id/radioButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clickable="true"
        app:frontImage="@drawable/ic_radio_button_unchecked"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rearImage="@drawable/ic_radio_button_checked" />

    <TextView
        android:id="@+id/textViewModelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/radioButton"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Parent"
        style="@style/StyleTextPrimary" />

    </androidx.constraintlayout.widget.ConstraintLayout>