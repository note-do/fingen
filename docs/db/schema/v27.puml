@startuml fingen_schema_v27
' Fingen local database (SQLite, fingen.db, DATABASE_VERSION = 27)
' Source: UpdateHelper.update27 (oldVersion < 27) + DBHelper.updateRunningBalance
' Branch: master

title Fingen local database schema (fingen.db, version 27)

skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80
skinparam entity {
  BackgroundColor #FEFEFE
  BorderColor #444444
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C9A227
}
hide circle

legend right
  |= Marker |= Meaning |
  | * | NOT NULL column |
  | PK | PRIMARY KEY |
  | FK | REFERENCES (ON DELETE action in brackets; every declared FK also has ON UPDATE CASCADE) |
  | UQ | UNIQUE constraint |
  | IX | index |
  | ~ sync | common columns of every ref_/log_ table: FBID, TS, Deleted (soft delete), Dirty, LastEdited |
  | ~ search | SearchString (denormalized search text) |
endlegend

' =====================================================================
package "Accounts" {

entity "ref_Currencies" as ref_Currencies {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * Code : TEXT
  * Symbol : TEXT
  * Name : TEXT
  * DecimalCount : INTEGER
  OrderNumber : INTEGER
  --
  UQ (Code, Deleted)
}

entity "ref_Accounts" as ref_Accounts {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * Type : INTEGER
  * Name : TEXT
  Currency : INTEGER <<FK ref_Currencies [SET NULL]>>
  Emitent : TEXT
  Last4Digits : INTEGER
  Comment : TEXT
  * StartBalance : REAL
  * IsClosed : INTEGER
  CustomOrder : INTEGER
  CreditLimit : REAL
  ~ search
  --
  UQ (Name, Deleted)
  --
  .. computed in queries, not stored: Income, Expense (from log_Running_Balance) ..
}

entity "ref_Accounts_Sets" as ref_Accounts_Sets {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  Name : TEXT
  --
  UQ (Name, Deleted)
}

entity "log_Accounts_Sets" as log_Accounts_Sets {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * SetID : INTEGER <<FK ref_Accounts_Sets [CASCADE]>>
  * AccountID : INTEGER <<FK ref_Accounts [CASCADE]>>
  --
  UQ (SetID, AccountID, Deleted)
}

}

' =====================================================================
package "Classifiers (hierarchical references)" {

entity "ref_Categories" as ref_Categories {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * Name : TEXT
  COLOR : TEXT
  ParentID : INTEGER <<FK ref_Categories (self) [SET NULL]>>
  * OrderNumber : INTEGER
  * Sign : INTEGER
  FullName : TEXT
  ~ search
  --
  UQ (Name, ParentID, Deleted)
}

entity "ref_Payees" as ref_Payees {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * Name : TEXT
  DefCategory : INTEGER <<FK ref_Categories [SET NULL]>>
  ParentID : INTEGER <<FK ref_Payees (self) [SET NULL]>>
  OrderNumber : INTEGER
  FullName : TEXT
  ~ search
  --
  UQ (Name, ParentID, Deleted)
}

entity "ref_Projects" as ref_Projects {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * Name : TEXT
  * isActive : INTEGER
  ParentID : INTEGER <<FK ref_Projects (self) [SET NULL]>>
  OrderNumber : INTEGER
  FullName : TEXT
  ~ search
  --
  UQ (Name, ParentID, Deleted)
}

entity "ref_Locations" as ref_Locations {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * Name : TEXT
  * Lon : REAL
  * Lat : REAL
  Radius : INTEGER
  Address : TEXT
  ParentID : INTEGER <<FK ref_Locations (self) [SET NULL]>>
  OrderNumber : INTEGER
  FullName : TEXT
  ~ search
  --
  UQ (Name, ParentID, Deleted)
}

entity "ref_Departments" as ref_Departments {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * Name : TEXT
  * isActive : INTEGER
  ParentID : INTEGER <<FK ref_Departments (self) [SET NULL]>>
  OrderNumber : INTEGER
  FullName : TEXT
  ~ search
  --
  UQ (Name, ParentID, Deleted)
}

entity "ref_SimpleDebts" as ref_SimpleDebts {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * Name : TEXT
  * isActive : INTEGER
  * StartAmount : REAL <<DEFAULT 0>>
  Currency : INTEGER <<FK ref_Currencies [SET NULL]>>
  ~ search
  --
  UQ (Name, Deleted)
}

entity "ref_Senders" as ref_Senders {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * Name : TEXT
  * PhoneNo : TEXT
  AmountPos : INTEGER
  BalancePos : INTEGER
  LeadingCurrencySymbol : INTEGER
  DateFormat : TEXT
  * isActive : INTEGER
  --
  UQ (Name, Deleted)
  UQ (PhoneNo, Deleted)
}

}

' =====================================================================
package "Transactions" {

entity "log_Transactions" as log_Transactions {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * DateTime : INTEGER
  * SrcAccount : INTEGER <<FK ref_Accounts [CASCADE]>>
  Payee : INTEGER <<FK ref_Payees [SET NULL]>>
  Category : INTEGER <<FK ref_Categories [SET NULL]>>
  * Amount : REAL
  Project : INTEGER <<FK ref_Projects [SET NULL]>>
  SimpleDebt : INTEGER <<FK ref_SimpleDebts [SET NULL]>>
  Department : INTEGER <<FK ref_Departments [SET NULL]>>
  Location : INTEGER <<FK ref_Locations [SET NULL]>>
  Comment : TEXT
  File : TEXT
  * DestAccount : INTEGER <<FK ref_Accounts [CASCADE]>>
  * ExchangeRate : REAL
  * AutoCreated : INTEGER
  Lon : REAL
  Lat : REAL
  Accuracy : INTEGER
  --
  IX idx (Deleted, DateTime, SrcAccount, DestAccount, Payee, Category, Project, Department, Location, SimpleDebt)
}

entity "log_Running_Balance" as log_Running_Balance {
  * AccountID : INTEGER <<PK, no FK declared -> ref_Accounts>>
  * TransactionID : INTEGER <<PK, no FK declared -> log_Transactions>>
  * DateTimeRB : INTEGER
  * Income : REAL
  * Expense : REAL
  --
  PK (AccountID, TransactionID)
  IX idx_RB_Accounts (AccountID)
  IX idx_RB_Transactions (TransactionID)
  IX idx_RB_DateTime (DateTimeRB)
}

}

' =====================================================================
package "Templates, SMS import" {

entity "log_Templates" as log_Templates {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * SrcAccount : INTEGER <<FK ref_Accounts [CASCADE]>>
  Payee : INTEGER <<FK ref_Payees [SET NULL]>>
  Category : INTEGER <<FK ref_Categories [SET NULL]>>
  * Amount : REAL
  Project : INTEGER <<FK ref_Projects [SET NULL]>>
  Department : INTEGER <<FK ref_Departments [SET NULL]>>
  Location : INTEGER <<FK ref_Locations [SET NULL]>>
  * Name : TEXT
  * DestAccount : INTEGER <<FK ref_Accounts [CASCADE]>>
  * ExchangeRate : REAL
  * Type : INTEGER
  Comment : TEXT
  ~ search
}

entity "log_Incoming_SMS" as log_Incoming_SMS {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * DateTime : TEXT
  * Sender : INTEGER <<no FK declared -> ref_Senders>>
  * Body : TEXT
}

entity "ref_Sms_Parser_Patterns" as ref_Sms_Parser_Patterns {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * Type : INTEGER
  * Object : TEXT
  * Pattern : TEXT
  --
  UQ (Type, Pattern, Deleted) <<ON CONFLICT REPLACE>>
}

}

' =====================================================================
package "Debts and budget" {

entity "ref_Debts" as ref_Debts {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * Account : INTEGER <<FK ref_Accounts [CASCADE]>>
  * Payee : INTEGER <<FK ref_Payees [CASCADE]>>
  * Category : INTEGER <<FK ref_Categories [SET NULL] - conflicts with NOT NULL>>
  * Closed : INTEGER
  SrcAccount : INTEGER <<no FK declared -> ref_Accounts>>
  Comment : TEXT
  --
  UQ (Account, Deleted)
}

entity "ref_budget" as ref_budget {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * Year : INTEGER
  * Month : INTEGER
  * Category : INTEGER <<FK ref_Categories [CASCADE]>>
  * Amount : REAL
  * Currency : INTEGER <<FK ref_Currencies [CASCADE]>>
  --
  UQ (Deleted, Year, Month, Category, Currency) <<ON CONFLICT REPLACE>>
}

entity "ref_budget_debts" as ref_budget_debts {
  * _id : INTEGER <<PK AUTOINCREMENT>>
  ~ sync
  * Year : INTEGER
  * Month : INTEGER
  * Debt : INTEGER <<FK ref_Debts [CASCADE]>>
  * Amount : REAL
  --
  UQ (Deleted, Year, Month, Debt) <<ON CONFLICT REPLACE>>
}

}

